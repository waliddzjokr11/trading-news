# Copy to .env and fill in — never commit .env
# Gmail SMTP (App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
ALERT_EMAIL_TO=destination@example.com

# Telegram Bot (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# CryptoPanic (optional, improves news) — free at https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# Optional: override config path
# CONFIG_PATH=config.yaml
